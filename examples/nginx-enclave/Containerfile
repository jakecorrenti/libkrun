FROM fedora:latest

RUN dnf -y install nginx openssl && dnf clean all

RUN mkdir -p /etc/nginx/ssl \
    && openssl req -x509 -nodes -days 365 \
        -subj "/CN=172.31.10.83" \
        -newkey rsa:2048 \
        -keyout /etc/nginx/ssl/server.key \
        -out /etc/nginx/ssl/server.crt

RUN rm -f /etc/nginx/conf.d/default.conf

COPY hello-world.conf /etc/nginx/conf.d/hello-world.conf

# Foreground master (PID 1) without relying on CMD argv quoting: many runners split
# `nginx -g daemon off;` into separate tokens ("off;" becomes a bogus flag).
RUN sed -i '/^pid /i daemon off;' /etc/nginx/nginx.conf

CMD ["nginx"]
